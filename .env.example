# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Only these emails can open HQ (comma-separated)
ADMIN_EMAILS=cto@nautiminds.com,ceo@nautiminds.com

# ── PostHog ──────────────────────────────────────────────
# us or eu
POSTHOG_REGION=
POSTHOG_PROJECT_ID=
# Personal API key scoped to this project, with query:read and project:read
POSTHOG_PERSONAL_API_KEY=

# ── Sentry ───────────────────────────────────────────────
SENTRY_ORG=
SENTRY_PROJECT=
# https://de.sentry.io for EU-region orgs (ours), https://sentry.io otherwise
SENTRY_BASE_URL=
# Internal integration token: project:read, event:read, org:read
SENTRY_AUTH_TOKEN=
# Optional: client secret of the internal integration (verifies webhooks, for live alerts)
SENTRY_WEBHOOK_SECRET=

# ── Google Play (keyless: Vercel OIDC → workload identity pool "vercel") ──
GCP_PROJECT_NUMBER=
# Service account the pool may impersonate; invited in Play Console (view app info + reply to reviews)
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_PACKAGE_NAME=com.nautiminds.marineprep
# Optional, for review history older than 7 days: Play Console → Download reports → Reviews → Copy Cloud Storage URI
GOOGLE_PLAY_REPORTS_BUCKET=

# ── App Store Connect (Team key, Customer Support role) ───
APP_STORE_APP_ID=6761722887
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
# Contents of the .p8 file, base64-encoded on one line
APP_STORE_PRIVATE_KEY_B64=

# ── Telegram alerts ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram user IDs allowed to press Approve / Reject (comma-separated)
TELEGRAM_ADMIN_IDS=
# Random string; Telegram sends it back on every webhook call (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# ── GitHub (approved fixes become issues) ────────────────
# Fine-grained token: this repo only, Issues read & write
GITHUB_TOKEN=
GITHUB_REPO=Nautiminds-EdTech/marineprep-user-app

# ── Claude (AI analyst) ──────────────────────────────────
ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to a workspace (Console → Workspaces → the workspace's ID)
ANTHROPIC_WORKSPACE_ID=

# ── Deployment ───────────────────────────────────────────
# Random string; Vercel Cron sends it as a Bearer token (openssl rand -hex 32)
CRON_SECRET=
# Public URL of HQ, for links in Telegram messages
HQ_URL=
